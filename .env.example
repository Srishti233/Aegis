# Copy to .env (optional). Everything has a safe-for-demo default.
# CHANGE the keys before exposing the gateway anywhere.
POSTGRES_PASSWORD=aegis
GATEWAY_PORT=8000

# --- upstream ---
# Leave as-is to use the bundled mock, or point at any OpenAI-compatible endpoint.
# Free local example (Ollama): UPSTREAM_URL=http://host.docker.internal:11434 and DEFAULT_MODEL=llama3.2
UPSTREAM_URL=http://mock-llm:9000
UPSTREAM_API_KEY=
DEFAULT_MODEL=mock-gpt

# --- keys ---
ADMIN_API_KEY=aegis-admin-change-me
DEMO_API_KEY=aegis-demo-key
DEMO_LIMITED_KEY=aegis-demo-limited
# Set EVAL_API_KEY empty to disable the evaluation keys.
EVAL_API_KEY=aegis-eval-key

# --- detection ---
# EMBEDDER: hash | minilm | auto. minilm needs: docker compose build --build-arg INSTALL_ML=1
EMBEDDER=hash
INSTALL_ML=0
CANARY_ENABLED=true
# Comma separated allowlist for URLs in model output, e.g. example.com,cdn.mycompany.com
EXFIL_ALLOWED_DOMAINS=

# --- audit / limits ---
# STORE_FULL_TEXT=true stores raw prompts/responses in the audit log (debug only!)
STORE_FULL_TEXT=false
RATE_LIMIT_RPM=60
TOKEN_BUDGET_PER_HOUR=200000
